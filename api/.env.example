# api/.env 完整课堂模板：复制前保留自己的数据库、登录及文本模型配置
APP_ENV=development
APP_NAME="Ecommerce Operation Assistant API"
DATABASE_URL=mysql+pymysql://root:替换为已有MySQL密码@127.0.0.1:3306/ecommerce_operation?charset=utf8mb4
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET_KEY=替换为至少32位随机字符串（python -c "import secrets;print(secrets.token_urlsafe(48))"）
AUTH_TOKEN_EXPIRE_MINUTES=10080
# 安全基线：生产环境自动生效，开发/测试环境自动跳过限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
MAX_REQUEST_BYTES=16777216
REDIS_URL=redis://:替换为已有Redis密码@127.0.0.1:6379/0
TASK_QUEUE_BACKEND=inline
CELERY_TASK_DEFAULT_QUEUE=generation
CELERY_AGENT_QUEUE=agent
CELERY_AGENT_WORKFLOW_QUEUE=agent.workflow
CELERY_MAINTENANCE_QUEUE=maintenance

# 保留第14、15章已经验证成功的文本模型，不改成媒体服务地址
LLM_BASE_URL=替换为已有文本模型Base_URL
LLM_API_KEY=替换为已有文本模型API_Key
LLM_MODEL=替换为已有文本模型名称

# 图片取字：OCR_BASE_URL/OCR_API_KEY 留空时沿用上面文本模型的地址与密钥，只换模型名即可
OCR_MODEL=qwen-vl-ocr-2025-11-20
OCR_BASE_URL=
OCR_API_KEY=
OCR_MAX_IMAGE_BYTES=8388608

# 即梦文生图3.0：api_key字段约定用英文冒号连接AK和SK
IMAGE_PROVIDER=jimeng
IMAGE_BASE_URL=https://visual.volcengineapi.com
IMAGE_API_KEY=替换为AccessKey:替换为SecretKey
IMAGE_MODEL=jimeng_t2i_v30
IMAGE_SIZE=1024*1024
IMAGE_WORKSPACE_ID=
IMAGE_POLL_INTERVAL_SECONDS=5
IMAGE_POLL_MAX_ATTEMPTS=60

# 即梦视频3.0 720P文生视频：5秒=121帧，10秒=241帧
VIDEO_PROVIDER=jimeng
VIDEO_BASE_URL=https://visual.volcengineapi.com
VIDEO_API_KEY=替换为AccessKey:替换为SecretKey
VIDEO_MODEL=jimeng_t2v_v30
VIDEO_SIZE=1280*720
VIDEO_DURATION=5
VIDEO_WORKSPACE_ID=
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_POLL_MAX_ATTEMPTS=90

# 保留已有检查点环境；本章不会启动Agent
AGENT_CHECKPOINT_HOST=127.0.0.1
AGENT_CHECKPOINT_PORT=5433
AGENT_CHECKPOINT_USER=agent
AGENT_CHECKPOINT_PASSWORD=替换为已有PostgreSQL密码
AGENT_CHECKPOINT_DATABASE=agent_checkpoints
AGENT_MAX_TOTAL_TOKENS=12000
AGENT_MAX_REVISIONS=1
OTEL_SERVICE_NAME=ecommerce-operation-agent
