# docker-compose 部署用的变量模板：复制为仓库根目录的 .env 后填写。
# 若不经 Docker、直接在本机跑 api，后端变量请改用 api/.env.example。
# 下列口令类字段必须替换为随机强值，禁止直接使用示例占位符。

MYSQL_ROOT_PASSWORD=replace_with_random_urlsafe_32_char_secret
MYSQL_DATABASE=ecommerce_operation
MYSQL_PORT=3306
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_random_urlsafe_32_char_secret
AGENT_POSTGRES_USER=agent
AGENT_POSTGRES_PASSWORD=replace_with_random_32_char_secret
AGENT_POSTGRES_DATABASE=agent_checkpoints
AGENT_POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000

APP_ENV=development
AUTH_SECRET_KEY=replace_with_random_48_char_secret
AUTH_TOKEN_EXPIRE_MINUTES=10080
AGENT_MAX_TOTAL_TOKENS=12000
AGENT_MAX_REVISIONS=1
OTEL_SERVICE_NAME=ecommerce-operation-agent
OTEL_EXPORTER_OTLP_ENDPOINT=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024*1024
IMAGE_WORKSPACE_ID=
IMAGE_POLL_INTERVAL_SECONDS=5
IMAGE_POLL_MAX_ATTEMPTS=24

VIDEO_PROVIDER=
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_SIZE=1280*720
VIDEO_DURATION=2
VIDEO_WORKSPACE_ID=
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_POLL_MAX_ATTEMPTS=36

# ---- 掌柜智库代理层（Docker 全栈）----
# 两个 compose 栈通过外部网络 kb-shared 互通：
#   docker network create kb-shared
# 智库服务在容器内监听 8010/8011，因此这里用服务名而不是 127.0.0.1。
KB_IMPORT_BASE_URL=http://kb-import-api:8010
KB_QUERY_BASE_URL=http://kb-query-api:8011
# 必须与智库栈 .env 中的 KB_INTERNAL_SECRET 一致；留空则知识库接口返回 503
KB_INTERNAL_SECRET=
KB_TIMEOUT_SECONDS=120
KNOWLEDGE_MAX_UPLOAD_BYTES=67108864
CELERY_KNOWLEDGE_QUEUE=knowledge
